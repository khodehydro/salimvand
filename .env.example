NODE_ENV=development
TZ=UTC
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_URL=http://localhost:4000/api/v1
API_PORT=4000
# Keep the API private; Nginx is the public entry point.
API_HOST=0.0.0.0
DATABASE_URL=postgresql://parts_store:parts_store_dev@localhost:5432/parts_store
REDIS_URL=redis://:redis_dev@localhost:6379
ENABLE_QUEUE_WORKER=false
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BALE_BOT_TOKEN=
BALE_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_FOLDER_ID=
BACKUP_ENCRYPTION_KEY=
# Local services are provided by docker-compose.dev.yml
# API readiness: GET http://localhost:4000/api/v1/health/ready
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Development only. Production builds force the same-origin /api/v1 proxy path.
VITE_API_URL=http://localhost:4000/api/v1
VITE_PUBLIC_SITE_URL=https://selimvand.ir
PUBLIC_SITE_URL=https://selimvand.ir
PUBLIC_CONTACT_PHONE=
# Seed: creates the initial super-admin user. Required for the panel to be
# reachable after `prisma:seed` (deploy runs it automatically). If left empty,
# the seed logs a note and creates no admin.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=مدیر سیستم
