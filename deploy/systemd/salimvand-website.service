[Unit]
Description=Salim Vand public website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=salimvand
Group=salimvand
WorkingDirectory=/opt/salimvand/apps/website
EnvironmentFile=/opt/salimvand/.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/salimvand/apps/website/.next/standalone/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
