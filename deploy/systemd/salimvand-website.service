[Unit]
Description=Salim Vand public website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=salimvand
Group=salimvand
WorkingDirectory=/opt/salimvand/apps/website
EnvironmentFile=/opt/salimvand/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
